@model DesignPatternsDay.Entities.Product
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@Model.Name - /organic</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" integrity="sha512-Fo3rlrZj/k7ujTnHg4CGR2D7kSs0v4LLanw2qksYuRlEzO+tcaEPQogQ0KaoGN26/zrn20ImR1DfuLWnOo7aBA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link rel="stylesheet" href="/organic-html/assets/css/bootstrap.min.css">
    <link rel="stylesheet" href="/organic-html/assets/css/style.css">
</head>
<body>
    <div class="body-wrap overflow-hidden">

        <!-- Header -->
        @await Html.PartialAsync("~/Views/Shared/Shop/_ShopHeaderComponentPartial.cshtml")

        <main>
            <!-- Breadcrumb -->
            <section class="breadcrumb_sec_1 position-relative">
                <div class="breadcrumb_wrap sec_space_mid_small"
                     style="background-image: url(/organic-html/assets/images/breadcrumb/breadcrumb1.png);">
                    <div class="breadcrumb_cont text-center">
                        <div class="breadcrumb_title">
                            <h2 class="text-white">@Model.Name</h2>
                        </div>
                        <ul class="list-unstyled breadcrumb_item d-flex justify-content-center align-items-center text-white">
                            <li><a href="/"><i class="fas fa-home active"></i> Home</a></li>
                            <li><i class="fas fa-chevron-right"></i></li>
                            <li><a href="/Shop">Shop</a></li>
                            <li><i class="fas fa-chevron-right"></i></li>
                            <li>@Model.Name</li>
                        </ul>
                    </div>
                </div>
            </section>

            <!-- Ürün Detay -->
            <section class="sec_space_large">
                <div class="container">
                    <div class="row g-5">
                        <!-- Sol: Ürün Fotoğrafı -->
                        <div class="col-lg-5">
                            <div class="d-flex justify-content-center align-items-center"
                                 style="background:#f8f9fa;border-radius:16px;padding:40px;min-height:350px;">
                                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/organic-html/assets/images/product/product1.png" : Model.ImageUrl)"
                                     alt="@Model.Name"
                                     style="max-height:300px;object-fit:contain;" />
                            </div>
                        </div>

                        <!-- Sağ: Ürün Bilgileri -->
                        <div class="col-lg-7">
                            <div class="product_detail_content">

                                <!-- Kategori badge -->
                                <span class="product_badge badge_meats rounded-pill text-uppercase mb-3 d-inline-block">
                                    @Model.Category
                                </span>
                                @if (Model.IsOrganic)
                                {
                                    <span class="product_badge badge_discount rounded-pill ms-2 d-inline-block">Organik</span>
                                }

                                <!-- Ürün Adı -->
                                <h2 class="mt-2">@Model.Name</h2>

                                <!-- Yıldız -->
                                <div class="rating_wrap d-flex align-items-center my-3">
                                    <ul class="rating_star ul_li">
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li><i class="far fa-star"></i></li>
                                    </ul>
                                    <span class="shop_review_text ms-2">( 4.0 )</span>
                                </div>

                                <!-- Fiyat — Decorator Pattern -->
                                <div class="product_price my-3">
                                    <span class="sale_price pe-2" style="font-size:28px">@Model.Price ₺</span>
                                    <span style="font-size:13px;color:#aaa">KDV dahil: <strong style="color:#7fad39">@ViewBag.PriceWithVat ₺</strong></span>
                                </div>
                                <div style="font-size:12px;color:#aaa;margin-top:-8px;margin-bottom:16px">
                                    @ViewBag.VatDescription
                                </div>

                                <!-- Stok -->
                                <div class="mb-3">
                                    @if (Model.Stock == 0)
                                    {
                                        <span class="badge bg-danger">Stok Yok</span>
                                    }
                                    else if (Model.Stock <= 5)
                                    {
                                        <span class="badge bg-warning text-dark">Son @Model.Stock adet!</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">Stokta var (@Model.Stock adet)</span>
                                    }
                                </div>

                                <!-- Sepete Ekle -->
                                <form method="post" action="/Cart/AddToCart" class="d-flex align-items-center gap-3 mt-4">
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <div class="quantity_input bg-white">
                                        <span class="input_number_decrement">–</span>
                                        <input class="input_number" name="quantity" value="1" min="1" />
                                        <span class="input_number_increment">+</span>
                                    </div>
                                    <button type="submit" class="btn custom_btn rounded-pill px-5 py-3 text-white">
                                        Sepete Ekle <i class="fas fa-shopping-bag ms-2"></i>
                                    </button>
                                </form>

                                <!-- Karşılaştırmaya Ekle -->
                                <form method="post" action="/Compare/AddToCompare" class="mt-3">
                                    <input type="hidden" name="productId" value="@Model.Id" />
                                    <button type="submit" class="btn btn-outline-success rounded-pill px-4">
                                        <i class="fas fa-exchange-alt"></i> Karşılaştırmaya Ekle
                                    </button>
                                </form>

                                <!-- Ürün Özellikleri -->
                                <div class="mt-4 pt-4" style="border-top:1px solid #eee">
                                    <table class="table table-sm">
                                        <tr>
                                            <td style="color:#aaa;width:140px">Kategori</td>
                                            <td><strong>@Model.Category</strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#aaa">Organik</td>
                                            <td><strong>@(Model.IsOrganic ? "✅ Evet" : "❌ Hayır")</strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#aaa">Stok</td>
                                            <td><strong>@Model.Stock adet</strong></td>
                                        </tr>
                                        <tr>
                                            <td style="color:#aaa">Eklenme Tarihi</td>
                                            <td><strong>@Model.CreatedAt.ToShortDateString()</strong></td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </main>

        @await Html.PartialAsync("~/Views/Shared/Shop/_ShopFooterComponentPartial.cshtml")
        @await Html.PartialAsync("~/Views/Shared/Shop/_ShopScriptComponentPartial.cshtml")
    </div>
</body>
</html>