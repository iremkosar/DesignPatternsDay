@{
    var trends = ViewBag.Trends as List<DesignPatternsDay.Entities.Trend>;
    var mainDishes = ViewBag.MainDishes as List<DesignPatternsDay.Entities.Product>;
    var starters = ViewBag.Starters as List<DesignPatternsDay.Entities.Product>;
    var drinks = ViewBag.Drinks as List<DesignPatternsDay.Entities.Product>;
}

<!-- trend section start -->
<section class="trend_section position-relative sec_top_space_70" data-aos="fade-up" data-aos-duration="2000">
    <div class="trend_section_wrap position-relative overflow-hidden sec_space_xlarge"
         style="background-image: url(/organic-html/assets/images/trends/trend1.png)">
        <div class="container">
            <div class="trend_top_content">
                <div class="trend_sub_title d-flex align-items-center justify-content-center">
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <span class="text-uppercase px-3">ÇİFTLİKTEN TAZE</span>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                </div>
                <div class="trend_top_title text-center pb-4">
                    <h2>En Çok Tercih Edilenler</h2>
                </div>
            </div>
            <div class="row justify-content-center text-center">
                @if (trends != null && trends.Any())
                {
                    @foreach (var trend in trends)
                    {
                        <div class="col-sm-6 col-lg-4">
                            <div class="trend_inner_content position-relative">
                                <div class="trend_thumb">
                                    <img src="@trend.ImageUrl" alt="@trend.Title">
                                </div>
                                <div class="trend_inner_text position-absolute">
                                    <h4 class="text-white">@trend.Title</h4>
                                    <a href="@trend.LinkUrl" class="text-white">
                                        HEMEN AL <i class="fas fa-long-arrow-alt-right text-white"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- product section-3 start -->
    <section class="product_section3" data-aos="fade-up" data-aos-duration="2000">
        <div class="product_section3_wrap inner_p_all_40 position-relative">
            <div class="container">
                <div class="product_sec_content_wrap position-relative overflow-hidden shadow inner_p_all_100 bg-white">
                    <div class="team_top_content text-center">
                        <div class="offer_sub_title d-flex align-items-center justify-content-center pb-2">
                            <i class="far fa-circle"></i>
                            <i class="far fa-circle"></i>
                            <i class="far fa-circle"></i>
                            <span class="text-uppercase px-3">ÇİFTLİKTEN TAZE</span>
                            <i class="far fa-circle"></i>
                            <i class="far fa-circle"></i>
                            <i class="far fa-circle"></i>
                        </div>
                        <div class="product_top_title text-center py-1">
                            <h2>Organik Ürünlerimiz</h2>
                        </div>
                        <div class="d-flex justify-content-center align-items-center">
                            <ul class="product_tabnav_3 nav nav-pills mb-4 mt-3" id="pills-tab" role="tablist">
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link active first_btn text-uppercase"
                                            id="pills-main-tab" data-bs-toggle="pill"
                                            data-bs-target="#pills-main" type="button" role="tab"
                                            aria-selected="true">
                                        Sebzeler & Etler
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link text-uppercase" id="pills-starter-tab"
                                            data-bs-toggle="pill" data-bs-target="#pills-starter" type="button"
                                            role="tab" aria-selected="false">
                                        Meyveler
                                    </button>
                                </li>
                                <li class="nav-item" role="presentation">
                                    <button class="nav-link last_btn text-uppercase" id="pills-drinks-tab"
                                            data-bs-toggle="pill" data-bs-target="#pills-drinks" type="button"
                                            role="tab" aria-selected="false">
                                        İçecekler
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>

                    <div class="tab-content" id="pills-tabContent">

                        <!-- Ana Yemekler: Vegetables + Meats -->
                        <div class="tab-pane fade show active" id="pills-main" role="tabpanel" aria-labelledby="pills-main-tab">
                            <div class="row g-4">
                                @if (mainDishes != null && mainDishes.Any())
                                {
                                    @foreach (var product in mainDishes)
                                    {
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="product_ctg_content_3 d-flex justify-content-center align-items-center position-relative">
                                                <div class="prdc_ctg_product_img d-flex justify-content-center align-items-center me-3">
                                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/category/cat6.png" : product.ImageUrl)" alt="@product.Name">
                                                </div>
                                                <div class="prdc_ctg_product_text">
                                                    <div class="prdc_ctg_product_rating my-1 rating_wrap d-flex">
                                                        <ul class="rating_star ul_li">
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li><i class="far fa-star"></i></li>
                                                        </ul>
                                                        <span class="shop_review_text">( 4.0 )</span>
                                                    </div>
                                                    <div class="prdc_ctg_product_title my-2">
                                                        <a href="/ProductDetail/Index/@product.Id"><h5>@product.Name</h5></a>
                                                    </div>
                                                    <div class="prdc_ctg_product_price mt-1 product_price">
                                                        <span class="sale_price pe-1">@product.Price ₺</span>
                                                    </div>
                                                    <ul class="product_action_btns ul_li_block d-flex">
                                                        <li>
                                                            <form method="post" action="/Cart/AddToCart">
                                                                <input type="hidden" name="productId" value="@product.Id" />
                                                                <input type="hidden" name="quantity" value="1" />
                                                                <button type="submit" style="background:none;border:none;cursor:pointer;">
                                                                    <i class="fas fa-shopping-bag"></i>
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center py-3" style="color:#aaa">Bu kategoride ürün yok.</div>
                                }
                            </div>
                        </div>

                        <!-- Meyveler: Fruits -->
                        <div class="tab-pane fade" id="pills-starter" role="tabpanel" aria-labelledby="pills-starter-tab">
                            <div class="row g-4">
                                @if (starters != null && starters.Any())
                                {
                                    @foreach (var product in starters)
                                    {
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="product_ctg_content_3 d-flex justify-content-center align-items-center position-relative">
                                                <div class="prdc_ctg_product_img d-flex justify-content-center align-items-center me-3">
                                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/category/cat6.png" : product.ImageUrl)" alt="@product.Name">
                                                </div>
                                                <div class="prdc_ctg_product_text">
                                                    <div class="prdc_ctg_product_rating my-1 rating_wrap d-flex">
                                                        <ul class="rating_star ul_li">
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li><i class="far fa-star"></i></li>
                                                        </ul>
                                                        <span class="shop_review_text">( 4.0 )</span>
                                                    </div>
                                                    <div class="prdc_ctg_product_title my-2">
                                                        <a href="/ProductDetail/Index/@product.Id"><h5>@product.Name</h5></a>
                                                    </div>
                                                    <div class="prdc_ctg_product_price mt-1 product_price">
                                                        <span class="sale_price pe-1">@product.Price ₺</span>
                                                    </div>
                                                    <ul class="product_action_btns ul_li_block d-flex">
                                                        <li>
                                                            <form method="post" action="/Cart/AddToCart">
                                                                <input type="hidden" name="productId" value="@product.Id" />
                                                                <input type="hidden" name="quantity" value="1" />
                                                                <button type="submit" style="background:none;border:none;cursor:pointer;">
                                                                    <i class="fas fa-shopping-bag"></i>
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center py-3" style="color:#aaa">Bu kategoride ürün yok.</div>
                                }
                            </div>
                        </div>

                        <!-- İçecekler: Beverages -->
                        <div class="tab-pane fade" id="pills-drinks" role="tabpanel" aria-labelledby="pills-drinks-tab">
                            <div class="row g-4">
                                @if (drinks != null && drinks.Any())
                                {
                                    @foreach (var product in drinks)
                                    {
                                        <div class="col-sm-6 col-lg-4">
                                            <div class="product_ctg_content_3 d-flex justify-content-center align-items-center position-relative">
                                                <div class="prdc_ctg_product_img d-flex justify-content-center align-items-center me-3">
                                                    <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/category/cat6.png" : product.ImageUrl)" alt="@product.Name">
                                                </div>
                                                <div class="prdc_ctg_product_text">
                                                    <div class="prdc_ctg_product_rating my-1 rating_wrap d-flex">
                                                        <ul class="rating_star ul_li">
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li class="active"><i class="fas fa-star"></i></li>
                                                            <li><i class="far fa-star"></i></li>
                                                        </ul>
                                                        <span class="shop_review_text">( 4.0 )</span>
                                                    </div>
                                                    <div class="prdc_ctg_product_title my-2">
                                                        <a href="/ProductDetail/Index/@product.Id"><h5>@product.Name</h5></a>
                                                    </div>
                                                    <div class="prdc_ctg_product_price mt-1 product_price">
                                                        <span class="sale_price pe-1">@product.Price ₺</span>
                                                    </div>
                                                    <ul class="product_action_btns ul_li_block d-flex">
                                                        <li>
                                                            <form method="post" action="/Cart/AddToCart">
                                                                <input type="hidden" name="productId" value="@product.Id" />
                                                                <input type="hidden" name="quantity" value="1" />
                                                                <button type="submit" style="background:none;border:none;cursor:pointer;">
                                                                    <i class="fas fa-shopping-bag"></i>
                                                                </button>
                                                            </form>
                                                        </li>
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="col-12 text-center py-3" style="color:#aaa">Bu kategoride ürün yok.</div>
                                }
                            </div>
                        </div>

                    </div>

                    <div class="product_sec3_btn text-center mt-5">
                        <a href="/Shop">
                            <button type="button" class="btn custom_btn rounded-pill px-3 text-white">
                                Tümünü Keşfet <i class="fas fa-long-arrow-alt-right"></i>
                            </button>
                        </a>
                    </div>
                    <img class="product3_left_thumb position-absolute" src="/organic-html/assets/images/shapes/shape17.png" alt="image_not_found">
                    <img class="product3_right_thumb position-absolute" src="/organic-html/assets/images/shapes/shape18.png" alt="image_not_found">
                </div>
            </div>
        </div>
    </section>
    <!-- product section-3 end -->

</section>
<!-- trend section end -->