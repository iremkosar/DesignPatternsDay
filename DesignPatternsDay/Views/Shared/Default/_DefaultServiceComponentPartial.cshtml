@{
    var services = ViewBag.Services as List<DesignPatternsDay.Entities.Service>;
}

<!-- service section start -->
<section class="service_setion2" data-aos="fade-up" data-aos-duration="2000">
    <div class="service_content_wrap2">
        <div class="container">
            <div class="row services2_content d-flex justify-content-between">
                @if (services != null && services.Any())
                {
                    int duration = 500;
                    @foreach (var service in services)
                    {
                        <div class="col-6 col-sm-4 col-lg-3">
                            <div class="service_inner_content d-flex justify-content-center align-items-center"
                                 data-aos="fade-up" data-aos-duration="@duration">
                                <div class="service_content_icon rounded-pill me-3">
                                    <img src="@service.IconUrl" alt="@service.Title">
                                </div>
                                <h6 class="service_content_title">@service.Title</h6>
                            </div>
                        </div>
                        duration += 500;
                    }
                }
            </div>
        </div>
    </div>
</section>
<!-- service section end -->