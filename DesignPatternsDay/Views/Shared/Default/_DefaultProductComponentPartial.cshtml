@{
    var latestProducts = ViewBag.LatestProducts as List<DesignPatternsDay.Entities.Product>;
}

<!-- product section start -->
<section class="product_section home2_product_sec" data-aos="fade-up" data-aos-duration="2000">
    <div class="container">
        <div class="row">
            <div class="col-lg-6">
                <div class="product_sec_content">
                    <div class="product_sec_sub_title d-flex align-items-center pb-2">
                        <i class="far fa-circle"></i>
                        <i class="far fa-circle"></i>
                        <i class="far fa-circle"></i>
                        <span class="ps-1">ÇİFTLİKTEN TAZE</span>
                    </div>
                    <h2 class="product_sec_title pb-3">Organik Ürünlerimiz</h2>
                </div>
            </div>
            <div class="col-lg-6 text-center text-lg-end">
                <a href="/Shop">
                    <button type="button" class="btn custom_btn rounded-pill px-4 py-2 text-white">
                        Tümünü Gör <i class="fas fa-long-arrow-alt-right"></i>
                    </button>
                </a>
            </div>
        </div>

        <div class="row g-4">
            @if (latestProducts != null && latestProducts.Any())
            {
                @foreach (var product in latestProducts)
                {
                    <div class="col-sm-6 col-md-6 col-xl-3">
                        <div class="product_layout_2 overflow-hidden position-relative">
                            <div class="product_layout_content bg-white position-relative">
                                <div class="product_image_wrap">
                                    <a class="product_image d-flex justify-content-center align-items-center"
                                       href="/ProductDetail/Index/@product.Id">
                                        <img class="pic-1"
                                             src="@(string.IsNullOrEmpty(product.ImageUrl) ? "/organic-html/assets/images/product/product1.png" : product.ImageUrl)"
                                             alt="@product.Name">
                                    </a>
                                    <ul class="product_badge_group ul_li_block">
                                        <li><span class="product_badge badge_meats position-absolute rounded-pill text-uppercase">@product.Category</span></li>
                                        @if (product.IsOrganic)
                                        {
                                            <li><span class="product_badge badge_discount position-absolute rounded-pill">Organik</span></li>
                                        }
                                    </ul>
                                    <ul class="product_action_btns ul_li_block d-flex">
                                        <li>
                                            <form method="post" action="/Cart/AddToCart">
                                                <input type="hidden" name="productId" value="@product.Id" />
                                                <input type="hidden" name="quantity" value="1" />
                                                <button type="submit" class="tooltips" style="background:none;border:none;cursor:pointer;" title="Sepete Ekle">
                                                    <i class="fas fa-shopping-bag"></i>
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </div>
                                <div class="rating_wrap d-flex">
                                    <ul class="rating_star ul_li">
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li class="active"><i class="fas fa-star"></i></li>
                                        <li><i class="far fa-star"></i></li>
                                    </ul>
                                    <span class="shop_review_text">( 4.0 )</span>
                                </div>
                                <div class="product_content">
                                    <h3 class="product_title">
                                        <a href="/ProductDetail/Index/@product.Id">@product.Name</a>
                                    </h3>
                                    <div class="product_price">
                                        <span class="sale_price pe-1">@product.Price ₺</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>
<!-- product section end -->