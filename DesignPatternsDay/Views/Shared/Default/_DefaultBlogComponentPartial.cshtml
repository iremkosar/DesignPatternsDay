@{
    var blogs = ViewBag.Blogs as List<DesignPatternsDay.Entities.Blog>;
}

<!-- blog section start -->
<section class="blog_section sec_space_xlarge position-relative" data-aos="fade-up" data-aos-duration="2000">
    <div class="blog_section_wrap">
        <div class="container-fluid-full">
            <div class="quality_top_content text-center">
                <div class="quality_sub_title d-flex justify-content-center align-items-center pb-2">
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <span class="px-2">ÇİFTLİKTEN TAZE</span>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                    <i class="far fa-circle"></i>
                </div>
                <div class="blog_top_title pb-5">
                    <h2>Son Blog Yazıları</h2>
                </div>
            </div>

            @if (blogs != null && blogs.Any())
            {
                <!-- Satır 1: blog[0] resim + blog[0] yazı + blog[1] resim + blog[1] yazı -->
                <div class="row p-0">
                    @if (blogs.Count > 0)
                    {
                        <div class="col-md-6 col-xl-3 p-0">
                            <a class="d-block" href="#">
                                <div class="blog_content_thumb" data-aos="fade-right" data-aos-duration="1000"
                                     style="background-image: url('@blogs[0].ImageUrl');">
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 col-xl-3 p-0">
                            <div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center" data-aos="fade-right" data-aos-duration="1500">
                                <div class="blog_subtitle text-uppercase d-inline-block">
                                    <h6 class="text-white">@blogs[0].SubTitle</h6>
                                </div>
                                <div class="blog_title pt-3">
                                    <a href="#"><h2>@blogs[0].Title</h2></a>
                                </div>
                                <div class="blog_icon">
                                    <img src="/organic-html/assets/images/shapes/shape20.png" alt="image_not_found">
                                </div>
                                <div class="blog_desc py-3">
                                    <p>@blogs[0].Content</p>
                                </div>
                            </div>
                        </div>
                    }
                    @if (blogs.Count > 1)
                    {
                        <div class="col-md-6 col-xl-3 p-0">
                            <a class="d-block" href="#">
                                <div class="blog_content_thumb" data-aos="fade-left" data-aos-duration="1000"
                                     style="background-image: url('@blogs[1].ImageUrl');">
                                </div>
                            </a>
                        </div>
                        <div class="col-md-6 col-xl-3 p-0">
                            <div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center" data-aos="fade-left" data-aos-duration="1500">
                                <div class="blog_subtitle text-uppercase d-inline-block">
                                    <h6 class="text-white">@blogs[1].SubTitle</h6>
                                </div>
                                <div class="blog_title pt-3">
                                    <a href="#"><h2>@blogs[1].Title</h2></a>
                                </div>
                                <div class="blog_icon">
                                    <img src="/organic-html/assets/images/shapes/shape20.png" alt="image_not_found">
                                </div>
                              
                                <div class="blog_desc py-3">
                                    <p>@blogs[1].Content</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Satır 2: blog[2] yazı + blog[2] resim + blog[3] yazı + blog[3] resim -->
                <div class="row p-0">
                    @if (blogs.Count > 2)
                    {
                        <div class="col-md-6 col-xl-3 p-0 order-2 order-md-0">
                            <div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center" data-aos="fade-right" data-aos-duration="1000">
                                <div class="blog_subtitle text-uppercase d-inline-block">
                                    <h6 class="text-white">@blogs[2].SubTitle</h6>
                                </div>
                                <div class="blog_title pt-3">
                                    <a href="#"><h2>@blogs[2].Title</h2></a>
                                </div>
                                <div class="blog_icon">
                                    <img src="/organic-html/assets/images/shapes/shape20.png" alt="image_not_found">
                                </div>
                               
                                <div class="blog_desc py-3">
                                    <p>@blogs[2].Content</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3 p-0 order-1 order-md-0">
                            <a class="d-block" href="#">
                                <div class="blog_content_thumb" data-aos="fade-right" data-aos-duration="1500"
                                     style="background-image: url('@blogs[2].ImageUrl');">
                                </div>
                            </a>
                        </div>
                    }
                    @if (blogs.Count > 3)
                    {
                        <div class="col-md-6 col-xl-3 p-0 order-5 order-md-0">
                            <div class="blog_content_text d-flex flex-column justify-content-center align-items-center text-center" data-aos="fade-left" data-aos-duration="1500">
                                <div class="blog_subtitle text-uppercase d-inline-block">
                                    <h6 class="text-white">@blogs[3].SubTitle</h6>
                                </div>
                                <div class="blog_title pt-3">
                                    <a href="#"><h2>@blogs[3].Title</h2></a>
                                </div>
                                <div class="blog_icon">
                                    <img src="/organic-html/assets/images/shapes/shape20.png" alt="image_not_found">
                                </div>
                               
                                <div class="blog_desc py-3">
                                    <p>@blogs[3].Content</p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6 col-xl-3 p-0 order-4 order-md-0">
                            <a class="d-block" href="#">
                                <div class="blog_content_thumb" data-aos="fade-left" data-aos-duration="1000"
                                     style="background-image: url('@blogs[3].ImageUrl');">
                                </div>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
<!-- blog section end -->