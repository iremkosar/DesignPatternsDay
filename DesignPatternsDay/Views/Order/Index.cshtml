@model List<DesignPatternsDay.Entities.Order>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Sipariş Yönetimi";
}

<h5 class="mb-4">Siparişler</h5>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">#</th>
                    <th>Müşteri</th>
                    <th>Telefon</th>
                    <th>Toplam</th>
                    <th>Durum</th>
                    <th>Tarih</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td class="ps-3">@order.Id</td>
                        <td>@order.CustomerName</td>
                        <td>@order.CustomerPhone</td>
                        <td>@order.TotalPrice.ToString("F2") ₺</td>
                        <td>
                            @if (order.Status == "Beklemede")
                            {
                                <span class="badge bg-warning text-dark">@order.Status</span>
                            }
                            else if (order.Status == "Hazırlanıyor")
                            {
                                <span class="badge bg-info text-dark">@order.Status</span>
                            }
                            else if (order.Status == "Kargoda")
                            {
                                <span class="badge bg-primary">@order.Status</span>
                            }
                            else if (order.Status == "Teslim Edildi")
                            {
                                <span class="badge bg-success">@order.Status</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@order.Status</span>
                            }
                        </td>
                        <td>@order.CreatedAt.ToShortDateString()</td>
                        <td>
                            <a href="/Admin/Order/Detail/@order.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> Detay
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>