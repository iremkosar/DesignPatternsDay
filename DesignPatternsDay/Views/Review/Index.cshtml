@model List<DesignPatternsDay.Entities.Review>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Müşteri Yorumları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Müşteri Yorumları</h5>
    <a href="/Admin/Review/Create" class="btn-green"><i class="fas fa-plus"></i> Yeni Yorum</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Müşteri</th>
                    <th>Yorum</th>
                    <th>Fotoğraf</th>
                    <th>Unvan</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.CustomerName</td>
                        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">@item.Comment</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width:40px;height:40px;border-radius:50%;object-fit:cover;" />
                            }
                        </td>
                        <td>@item.Title</td>
                        <td>
                            @if (item.IsApproved)
                            {
                                <span class="badge bg-success">Onaylı</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Beklemede</span>
                            }
                        </td>
                        <td>
                            @if (!item.IsApproved)
                            {
                                <form method="post" action="/Admin/Review/Approve/@item.Id" style="display:inline">
                                    <button type="submit" class="btn btn-sm btn-outline-success me-1">
                                        <i class="fas fa-check"></i> Onayla
                                    </button>
                                </form>
                            }
                            <form method="post" action="/Admin/Review/Delete/@item.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>