@model List<DesignPatternsDay.Entities.Product>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Ürün Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Ürün Listesi</h5>
    <a href="/Admin/Product/Create" class="btn-green">
        <i class="fas fa-plus"></i> Yeni Ürün Ekle
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Fotoğraf</th>
                    <th class="ps-3">Ürün Adı</th>
                    <th>Kategori</th>
                    <th>Fiyat</th>
                    <th>Stok</th>
                    <th>Organik</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var product in Model)
                {
                    <tr>
                        <td class="ps-3">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" style="width:50px;height:50px;object-fit:cover;border-radius:8px;" />
                            }
                            else
                            {
                                <div style="width:50px;height:50px;background:#f0f2f5;border-radius:8px;display:flex;align-items:center;justify-content:center;">
                                    <i class="fas fa-image" style="color:#adb5bd"></i>
                                </div>
                            }
                        </td>
                        <td class="ps-3 fw-500">@product.Name</td>
                        <td>@product.Category</td>
                        <td>@product.Price ₺</td>
                        <td>
                            @if (product.Stock == 0)
                            {
                                <span class="badge-red">Tükendi</span>
                            }
                            else if (product.Stock <= 5)
                            {
                                <span class="badge-orange">@product.Stock (Düşük)</span>
                            }
                            else
                            {
                                <span class="badge-green">@product.Stock</span>
                            }
                        </td>
                        <td>@(product.IsOrganic ? "✅" : "❌")</td>
                        <td>
                            <a href="/Admin/Product/Edit/@product.Id" class="btn btn-sm btn-outline-primary me-1">
                                <i class="fas fa-edit"></i>
                            </a>
                            <a href="/Admin/Product/Delete/@product.Id" class="btn btn-sm btn-outline-danger">
                                <i class="fas fa-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>