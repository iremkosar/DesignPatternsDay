@model DesignPatternsDay.Entities.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Ürün Düzenle";
}

<div class="card" style="max-width:600px">
    <div class="card-body p-4">
        <form method="post" action="/Admin/Product/Edit/@Model.Id" enctype="multipart/form-data">
            <input type="hidden" name="Id" value="@Model.Id"/>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Ürün Adı</label>
                <input type="text" name="Name" value="@Model.Name" class="form-control form-control-sm" required/>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Kategori</label>
                <select name="Category" class="form-select form-select-sm">
                    <option value="Vegetables" @@(Model.Category == "Vegetables" ? "selected" : "")>Vegetables</option>
                    <option value="Fruits" @@(Model.Category == "Fruits" ? "selected" : "")>Fruits</option>
                    <option value="Meats" @@(Model.Category == "Meats" ? "selected" : "")>Meats</option>
                    <option value="Beverages" @@(Model.Category == "Beverages" ? "selected" : "")>Beverages</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Fiyat (₺)</label>
                <input type="number" step="0.01" name="Price" value="@Model.Price" class="form-control form-control-sm" required/>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Stok</label>
                <input type="number" name="Stock" value="@Model.Stock" class="form-control form-control-sm" required/>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Ürün Fotoğrafı URL</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div class="mb-2">
                        <img src="@Model.ImageUrl" style="height:80px;border-radius:8px;object-fit:cover;" />
                    </div>
                }
                <input type="text" name="ImageUrl" value="@Model.ImageUrl" class="form-control form-control-sm" placeholder="https://example.com/image.jpg" />
            </div>
            <div class="mb-4">
                <div class="form-check">
                    <input type="checkbox" name="IsOrganic" value="true" class="form-check-input" id="isOrganic" @(Model.IsOrganic ? "checked" : "")/>
                    <label class="form-check-label" for="isOrganic" style="font-size:13px">Organik Ürün</label>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-green">
                    <i class="fas fa-save"></i> Güncelle
                </button>
                <a href="/Admin/Product" class="btn btn-sm btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>