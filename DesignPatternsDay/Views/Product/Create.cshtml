@model DesignPatternsDay.Entities.Product
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Yeni Ürün Ekle";
}

<div class="card" style="max-width:600px">
    <div class="card-body p-4">
        <form method="post" action="/Admin/Product/Create" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Ürün Adı</label>
                <input type="text" name="Name" class="form-control form-control-sm" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Kategori</label>
                <select name="Category" class="form-select form-select-sm">
                    <option value="Vegetables">Vegetables</option>
                    <option value="Fruits">Fruits</option>
                    <option value="Meats">Meats</option>
                    <option value="Beverages">Beverages</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">İndirim Tipi</label>
                <select name="discountType" class="form-select form-select-sm">
                    <option value="standard">Standart (%5)</option>
                    <option value="bulk">Toplu (%15)</option>
                    <option value="seasonal">Sezonluk (%10)</option>
                </select>
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Ürün Fotoğrafı URL</label>
                <input type="text" name="ImageUrl" class="form-control form-control-sm" placeholder="https://example.com/image.jpg" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Fiyat (₺)</label>
                <input type="number" step="0.01" name="Price" class="form-control form-control-sm" required />
            </div>
            <div class="mb-3">
                <label class="form-label fw-500" style="font-size:13px">Stok</label>
                <input type="number" name="Stock" class="form-control form-control-sm" required />
            </div>
            <div class="mb-4">
                <div class="form-check">
                    <input type="checkbox" name="IsOrganic" value="true" class="form-check-input" id="isOrganic" />
                    <label class="form-check-label" for="isOrganic" style="font-size:13px">Organik Ürün</label>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn-green">
                    <i class="fas fa-save"></i> Kaydet
                </button>
                <a href="/Admin/Product" class="btn btn-sm btn-outline-secondary">İptal</a>
            </div>
        </form>
    </div>
</div>