@model List<DesignPatternsDay.Entities.Service>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Servis Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Servis Listesi</h5>
    <a href="/Admin/Service/Create" class="btn-green"><i class="fas fa-plus"></i> Yeni Servis</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Başlık</th>
                    <th>İkon</th>
                    <th>Sıra No</th>
                    <th>Aktif</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.Title</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.IconUrl))
                            {
                                <img src="@item.IconUrl" style="width:40px;height:40px;object-fit:contain;" />
                            }
                        </td>
                        <td>@item.OrderNo</td>
                        <td>@(item.IsActive ? "✅" : "❌")</td>
                        <td>
                            <a href="/Admin/Service/Edit/@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
                            <form method="post" action="/Admin/Service/Delete/@item.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>