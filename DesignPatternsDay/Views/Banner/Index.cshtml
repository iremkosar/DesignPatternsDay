@model List<DesignPatternsDay.Entities.Banner>
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewBag.Title = "Banner Yönetimi";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h5 class="mb-0">Banner Listesi</h5>
    <a href="/Admin/Banner/Create" class="btn-green"><i class="fas fa-plus"></i> Yeni Banner</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th class="ps-3">Başlık</th>
                    <th>Alt Başlık</th>
                    <th>Buton</th>
                    <th>Fotoğraf</th>
                    <th>Aktif</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ps-3">@item.Title</td>
                        <td>@item.SubTitle</td>
                        <td>@item.ButtonText</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ImageUrl))
                            {
                                <img src="@item.ImageUrl" style="width:50px;height:35px;object-fit:cover;border-radius:4px;" />
                            }
                        </td>
                        <td>@(item.IsActive ? "✅" : "❌")</td>
                        <td>
                            <a href="/Admin/Banner/Edit/@item.Id" class="btn btn-sm btn-outline-primary me-1"><i class="fas fa-edit"></i></a>
                            <form method="post" action="/Admin/Banner/Delete/@item.Id" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Silinsin mi?')">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>